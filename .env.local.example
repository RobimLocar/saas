# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Stripe — Price IDs de assinatura (mensal; um por plano)
STRIPE_STARTER_PRICE_ID=YOUR_STARTER_PRICE_ID
STRIPE_PRO_PRICE_ID=YOUR_PRO_PRICE_ID
STRIPE_AGENCY_PRICE_ID=YOUR_AGENCY_PRICE_ID

# Stripe — Price IDs dos packs de top-up (crédito avulso)
STRIPE_TOPUP_100_PRICE_ID=YOUR_TOPUP_100_PRICE_ID
STRIPE_TOPUP_250_PRICE_ID=YOUR_TOPUP_250_PRICE_ID
STRIPE_TOPUP_500_PRICE_ID=YOUR_TOPUP_500_PRICE_ID
STRIPE_TOPUP_1000_PRICE_ID=YOUR_TOPUP_1000_PRICE_ID
STRIPE_TOPUP_2000_PRICE_ID=YOUR_TOPUP_2000_PRICE_ID

# PiAPI (provedor principal)
PIAPI_API_KEY=YOUR_PIAPI_KEY
# Webhook do PiAPI (OPCIONAL): sem estes dois, a entrega funciona só por POLLING e o
# webhook REJEITA qualquer callback (fail-closed). Defina AMBOS para habilitar o webhook.
PUBLIC_BASE_URL=https://your-app-domain
PIAPI_WEBHOOK_SECRET=YOUR_PIAPI_WEBHOOK_SECRET
# Timeout de gerações presas (min); default 30 se ausente.
GENERATION_TIMEOUT_MINUTES=30

# fal.ai (provedor de redundância — substitui Atlas na v2)
FAL_API_KEY=YOUR_FAL_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Atlas Cloud (TTS/voz)
ATLAS_API_KEY=YOUR_ATLAS_KEY
